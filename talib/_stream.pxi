    TA_RetCode TA_WMA_Advance(TA_WMA_Stream* stream)

    ctypedef struct TA_ZLEMA_Stream:
        pass
    TA_RetCode TA_ZLEMA_OpenAndFill(TA_ZLEMA_Stream** stream, const double* inReal, int historyLen, int optInTimePeriod, int* outBegIdx, int* outNBElement, double* outReal)
    TA_RetCode TA_ZLEMA_Open(TA_ZLEMA_Stream** stream, const double* inReal, int historyLen, int optInTimePeriod, double* outReal)
    TA_RetCode TA_ZLEMA_Update(TA_ZLEMA_Stream* stream, double inReal, double* outReal)
